# syntax=docker/dockerfile:1
# KEYCLOAK_BASE must be a reviewed Keycloak 26 immutable image digest.
ARG KEYCLOAK_BASE
FROM ${KEYCLOAK_BASE} AS builder

ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build

ARG KEYCLOAK_BASE
FROM ${KEYCLOAK_BASE}
ARG KEYCLOAK_BASE
COPY --from=builder /opt/keycloak/ /opt/keycloak/
LABEL org.opencontainers.image.base.name="${KEYCLOAK_BASE}"
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
