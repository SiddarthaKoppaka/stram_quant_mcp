# Non-secret SIDDU authentication deployment configuration.
# Copy to /etc/stram-quant/auth.env with root:root mode 0600.
# Resolve and review both image digests before use; tags alone are rejected.
KEYCLOAK_BASE_IMAGE_REF=quay.io/keycloak/keycloak@sha256:REPLACE_WITH_REVIEWED_DIGEST
KEYCLOAK_IMAGE_REF=registry.REPLACE_WITH_PRIVATE_DNS/stram/keycloak:26.8.1-stram1@sha256:REPLACE_WITH_REVIEWED_DIGEST
POSTGRES_BASE_IMAGE_REF=docker.io/library/postgres:17.11-bookworm@sha256:REPLACE_WITH_REVIEWED_DIGEST
POSTGRES_IMAGE_REF=registry.REPLACE_WITH_PRIVATE_DNS/stram/postgres:17.11-stram1@sha256:REPLACE_WITH_REVIEWED_DIGEST
KEYCLOAK_PUBLIC_URL=https://auth.REPLACE_WITH_PRIVATE_DNS
KEYCLOAK_ADMIN_URL=https://auth-admin.REPLACE_WITH_PRIVATE_DNS
KEYCLOAK_REALM=stram-staging
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_HOST_PORT=9080
KEYCLOAK_MANAGEMENT_PORT=9001
STRAM_MCP_RESOURCE_URL=https://quant.REPLACE_WITH_PRIVATE_DNS/mcp
STRAM_MCP_TENANT_ID=local-stram
STRAM_MCP_ALLOWED_HOSTS=quant.REPLACE_WITH_PRIVATE_DNS
# Current SIDDU Tailscale IPv4 used for a static container host mapping and
# UID-scoped HTTPS-only egress rule. The installer verifies it against tailscale.
STRAM_PRIVATE_HOST_IPV4=100.64.0.1
# A reviewed private CA bundle may be added after it is installed in the immutable MCP image.
STRAM_PRIVATE_CA_FILE=
