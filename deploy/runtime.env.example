# Host-owned deployment values. Copy outside the repository with mode 0600.
STRAM_MCP_IMAGE=registry.example.invalid/stram/stram-quant-mcp
STRAM_MCP_IMAGE_DIGEST=sha256:REPLACE_WITH_APPROVED_DIGEST
STRAM_MCP_NETWORK=stram-quant-private
STRAM_MCP_HOST_PORT=8800
STRAM_MCP_LAKE_PATH=/srv/stram/data-lake/parquet-readonly
STRAM_MCP_AUDIT_PATH=/srv/stram/quant-mcp-audit
STRAM_MCP_AUDIT_KEY_PATH=/run/stram-secrets/quant-mcp-audit-key
