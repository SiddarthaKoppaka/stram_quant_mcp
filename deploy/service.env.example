# Non-secret service configuration. The audit key is file-mounted separately.
STRAM_MCP_DATA_URL=https://data.example.invalid:8444
STRAM_MCP_DATA_TOKEN_URL=https://issuer.example.invalid/realms/REPLACE/protocol/openid-connect/token
STRAM_MCP_DATA_CLIENT_ID=REPLACE_WITH_CLIENT_ID
STRAM_MCP_DATA_CLIENT_SECRET_FILE=/run/secrets/data-client-secret
STRAM_MCP_AUDIT_DB=/audit/audit.sqlite3
STRAM_MCP_AUDIT_KEY_FILE=/run/secrets/audit-key
STRAM_MCP_ISSUER_URL=https://issuer.example.invalid/
STRAM_MCP_RESOURCE_URL=https://quant.example.invalid/mcp
STRAM_MCP_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
STRAM_MCP_TENANT_ID=REPLACE_WITH_TENANT
STRAM_MCP_ALLOWED_HOSTS=quant.example.invalid
# Leave empty for non-browser MCP clients. Add only exact, reviewed browser origins.
STRAM_MCP_ALLOWED_ORIGINS=
STRAM_MCP_OTLP_ENDPOINT=https://otel.example.invalid
STRAM_MCP_IMAGE_DIGEST=sha256:REPLACE_WITH_APPROVED_DIGEST
STRAM_MCP_BIND_HOST=0.0.0.0
STRAM_MCP_BIND_PORT=8000
STRAM_MCP_DATA_MAX_CONCURRENT=4
STRAM_MCP_DATA_BREAKER_THRESHOLD=5
STRAM_MCP_DATA_BREAKER_COOLDOWN_SECONDS=15
STRAM_MCP_BACKEND_SHUTDOWN_SECONDS=5
# Optional: callers denied this many times in the window are blocked until their denials age out.
# STRAM_MCP_DENIAL_LIMIT=5
# STRAM_MCP_DENIAL_WINDOW_SECONDS=60
